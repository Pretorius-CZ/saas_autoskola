# Zkopíruj tento soubor jako .env.local a doplň hodnoty.
# .env.local je v .gitignore — do gitu se nikdy nedostane.

# --- připojení, kterým běží aplikace ---------------------------------------
# Omezený účet autoskola_app: umí číst a zapisovat řádky, nic víc.
# Nemůže zakládat ani rušit tabulky a neobejde izolaci po autoškolách.
# Vyrobí ho příkaz: npm run db:role
# JEN TENHLE ŘETĚZEC patří na Vercel.
DATABASE_URL="postgresql://autoskola_app:heslo@ep-neco-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- připojení vlastníka ----------------------------------------------------
# Účet neondb_owner z Neonu. Používají ho migrace (db:push), seed a db:rls.
# Na Vercel NEPATŘÍ — nasazená aplikace nemá mít právo zahodit tabulku.
DATABASE_URL_OWNER="postgresql://neondb_owner:heslo@ep-neco-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Nepoolované připojení vlastníka. Používá ho zálohování (pg_dump).
DATABASE_URL_UNPOOLED=""

# --- přihlašování ------------------------------------------------------------
# Podepisuje přihlášení. Aspoň 32 náhodných znaků.
# Vygeneruj příkazem:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
