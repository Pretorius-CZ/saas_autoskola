# Zkopíruj tento soubor jako .env.local a doplň hodnoty.
# .env.local je v .gitignore — do gitu se nikdy nedostane.

# Připojovací řetězec z Neonu (Dashboard → Connection string → Pooled connection).
# Doplní ho i příkaz: neon link --project-id <id> --branch production -y
DATABASE_URL="postgresql://uzivatel:heslo@ep-neco-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Nepoolované připojení. Používá ho zálohování (pg_dump), ne aplikace.
DATABASE_URL_UNPOOLED=""

# Podepisuje přihlášení. Aspoň 32 náhodných znaků.
# Vygeneruj příkazem:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
